# Application
NOTIFICATION_APPLICATION_NAME=notification-service
NOTIFICATION_ADDRESS=0.0.0.0
NOTIFICATION_PORT=8083

# Mail
# SMTP. Gmail requires an App Password (not the account password):
# https://myaccount.google.com/apppasswords
# Local dev alternative: docker compose --profile mail up -d mailhog
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=