# Assistant service
ASSISTANT_APP_NAME=assistant-service
ASSISTANT_PORT=8084

# Postgres (assistant_db is created by init-postgres.sql)
ASSISTANT_DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/assistant_db

# Booking service for future tool calls (stage 3)
ASSISTANT_BOOKING_BASE_URL=http://booking-service:8082

# LLM backends. Stages pick a backend by name (local|external|mock); "mock"
# needs no model. "local" targets a llama.cpp server (`llama server -m ...`).
ASSISTANT_LLM_LOCAL_BASE_URL=http://llama-chat:8089/v1
ASSISTANT_LLM_LOCAL_MODEL=lfm3-1.7b
ASSISTANT_LLM_EXTERNAL_BASE_URL=https://api.openai.com/v1
ASSISTANT_LLM_EXTERNAL_API_KEY=
ASSISTANT_LLM_EXTERNAL_MODEL=gpt-4o-mini
ASSISTANT_LLM_STAGES=structure:local
ASSISTANT_LLM_DISABLE_THINKING=true
ASSISTANT_LLM_FALLBACK_ENABLED=false
ASSISTANT_LLM_TIMEOUT_S=60.0

# Hybrid search wiring
ASSISTANT_QDRANT_URL=http://qdrant:6333
ASSISTANT_QDRANT_COLLECTION=events
ASSISTANT_QDRANT_COLLECTION_VENUES=venues
ASSISTANT_LLAMA_EMBED_URL=http://host.docker.internal:8088
ASSISTANT_COLLECTOR_BASE_URL=http://collector-service:8080

# Domain defaults (no hardcoded city/currency/locale in code).
ASSISTANT_DEFAULT_CITY=Минск
ASSISTANT_DEFAULT_TIMEZONE=Europe/Minsk
ASSISTANT_DEFAULT_CURRENCY=BYN
ASSISTANT_DEFAULT_LANGUAGE=ru
ASSISTANT_DEFAULT_LATITUDE=53.9056
ASSISTANT_DEFAULT_LONGITUDE=27.5539

# Weather cache (Redis from docker-compose) + retry policy.
ASSISTANT_REDIS_URL=redis://redis:6379/0
ASSISTANT_WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
ASSISTANT_WEATHER_ATTEMPTS=3
ASSISTANT_WEATHER_BACKOFF_BASE_S=0.5
ASSISTANT_WEATHER_TIMEOUT_S=15.0
ASSISTANT_WEATHER_CACHE_TTL_S=21600

# Holds sweep (APScheduler in-process); false = manual POST /assistant/holds/sweep only.
ASSISTANT_SCHEDULER_ENABLED=true
ASSISTANT_SWEEP_INTERVAL_S=300

# OpenAPI docs (/docs, /redoc, /openapi.json); false in production.
ASSISTANT_DOCS_ENABLED=true
# Structured logging: json for containers, text for local runs.
ASSISTANT_LOG_FORMAT=json
ASSISTANT_LOG_LEVEL=INFO
