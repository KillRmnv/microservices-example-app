# Assistant service
ASSISTANT_APP_NAME=assistant-service
ASSISTANT_PORT=8084

# Postgres (assistant_db is created by init-postgres.sql)
ASSISTANT_DATABASE_URL=postgresql://postgres:1234@postgres:5432/assistant_db

# Booking service for future tool calls (stage 3)
BOOKING_BASE_URL=http://booking-service:8082

# LLM backends. Stages pick a backend by name, e.g.
# "structure:ollama,plan:external,telegram:external"
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
LLM_EXTERNAL_BASE_URL=https://api.openai.com/v1
LLM_EXTERNAL_API_KEY=
LLM_EXTERNAL_MODEL=gpt-4o-mini
LLM_STAGES=structure:ollama,plan:external,telegram:external
LLM_TIMEOUT_S=60.0
