@startuml
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80
title user-service — identity and roles

entity "permissions" as permissions {
  * id : bigint
  + name : character varying
}

entity "role_permissions" as role_permissions {
  * role_id : bigint
  * permission_id : bigint
}

entity "roles" as roles {
  * id : bigint
  + name : character varying
}

entity "users" as users {
  * id : bigint
  + username : character varying
  + email : character varying
  + password_hash : character varying
  + role_id : bigint
  + is_system : boolean
}

role_permissions }o--|| permissions : "permission_id → id\non delete CASCADE"
role_permissions }o--|| roles : "role_id → id\non delete CASCADE"
users }o--|| roles : "role_id → id\non delete RESTRICT"
@enduml
