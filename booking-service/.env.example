# Application
BOOKING_APPLICATION_NAME=booking-service

BOOKING_APPLICATION_PORT=8082
BOOKING_APPLICATION_ADDRESS=0.0.0.0

BOOKING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/booking_service
BOOKING_DATASOURCE_USERNAME=postgres
BOOKING_DATASOURCE_PASSWORD=CHANGE_ME

BOOKING_DATA_REDIS_HOST=redis
BOOKING_DATA_REDIS_PORT=6379

SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092



# Compacted search catalog stream consumed by collector-service.
BOOKING_CATALOG_TOPIC=booking.catalog
# Republish the whole events table on startup (bootstrap for a fresh index).
BOOKING_CATALOG_PUBLISH_ON_STARTUP=true
