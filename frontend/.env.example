# Assistant chat: 'true' keeps the built-in demo scenarios,
# anything else calls the live backend at /assistant/dialogue/v2.
NEXT_PUBLIC_ASSISTANT_MOCK=false

# Domain defaults for the dialogue contract (no hardcoded city/language in code).
NEXT_PUBLIC_DEFAULT_CITY=Минск
NEXT_PUBLIC_DEFAULT_LANGUAGE=ru

# 2GIS MapGL JS key (client-side, baked into the static export).
# Same demo key as COLLECTOR_TWOGIS_API_KEY unless you have a dedicated one.
NEXT_PUBLIC_2GIS_MAP_KEY=
