# Collector service
COLLECTOR_APP_NAME=collector-service
COLLECTOR_PORT=8085

# Postgres (collector_db is created by init-postgres.sql)
COLLECTOR_DATABASE_URL=postgresql://postgres:1234@postgres:5432/collector_db

# HTTP politeness
COLLECTOR_USER_AGENT=dosug-collector/0.1 (+https://github.com/KillRmnv/microservices-example-app)
COLLECTOR_DEFAULT_MIN_INTERVAL_S=1.0
COLLECTOR_MAX_ATTEMPTS=4
COLLECTOR_BACKOFF_BASE_S=2.0
COLLECTOR_TIMEOUT_S=20.0

# Per-source overrides, e.g. "relax:10,afisha_me:10,ticketpro:0.5"
# Relax and Afisha.me robots say Crawl-delay 10 — keep it.
COLLECTOR_SOURCE_INTERVALS=relax:10,afisha_me:10,ticketpro:0.5
