# Collector service
COLLECTOR_APP_NAME=collector-service
COLLECTOR_PORT=8085

# Domain defaults (no hardcoded city/currency/timezone in code).
COLLECTOR_DEFAULT_CITY=Минск
COLLECTOR_DEFAULT_TIMEZONE=Europe/Minsk
COLLECTOR_DEFAULT_CURRENCY=BYN

# Postgres (collector_db is created by init-postgres.sql)
COLLECTOR_DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/collector_db

# HTTP politeness
COLLECTOR_USER_AGENT=dosug-collector/0.1 (+https://github.com/KillRmnv/microservices-example-app)
COLLECTOR_DEFAULT_MIN_INTERVAL_S=1.0
COLLECTOR_MAX_ATTEMPTS=4
COLLECTOR_BACKOFF_BASE_S=2.0
COLLECTOR_TIMEOUT_S=20.0

# Per-source overrides, e.g. "relax:10,afisha_me:10,ticketpro:0.5"
# Relax and Afisha.me robots say Crawl-delay 10 — keep it.
COLLECTOR_SOURCE_INTERVALS=relax:10,afisha_me:10,ticketpro:0.5,telegram:2

# Qdrant + embeddings (llama server with bge-m3 --embedding)
COLLECTOR_QDRANT_URL=http://qdrant:6333
COLLECTOR_QDRANT_COLLECTION=events
COLLECTOR_QDRANT_VECTOR_SIZE=1024
COLLECTOR_LLAMA_EMBED_URL=http://host.docker.internal:8088
COLLECTOR_EMBED_BATCH_SIZE=32

# Telegram channels (verify against the Mininform list before adding!)
COLLECTOR_TELEGRAM_CHANNELS=minsk_kuda,kuda_shodit_by
COLLECTOR_TELEGRAM_MAX_PAGES=5
COLLECTOR_TELEGRAM_LLM_FALLBACK=false

# Scheduler: "source:seconds" intervals; set ENABLED=false to run manual-only.
COLLECTOR_SCHEDULER_ENABLED=true
COLLECTOR_SCHEDULES=ticketpro:21600,relax:86400,afisha_me:86400,telegram:1200

# Ops alerting: degraded sources are POSTed here as {"text": ...}.
COLLECTOR_OPS_WEBHOOK_URL=
COLLECTOR_OPS_ALERT_WINDOW=2

# 2GIS Places API (demo key: 1000 req/month!). The REAL key goes ONLY into
# the untracked collector-service/.env as COLLECTOR_TWOGIS_API_KEY.
# Never commit it: rotate in the 2GIS cabinet if it ever leaks.
COLLECTOR_TWOGIS_API_KEY=
COLLECTOR_TWOGIS_BASE_URL=https://catalog.api.2gis.com
COLLECTOR_TWOGIS_REGION=
COLLECTOR_TWOGIS_LOCALE=
COLLECTOR_TWOGIS_BBOX=53.5,54.3,27.1,28.1
COLLECTOR_TWOGIS_MONTHLY_CAP=1000
COLLECTOR_TWOGIS_RESERVE=100